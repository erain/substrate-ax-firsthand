+func TestBuildActorTemplate_CurrentSubstrateAPI(t *testing.T) {
+	tmpl := BuildActorTemplate("ax-lab", "current-api", "localhost:5001/runner@sha256:abc", nil, nil, "gs://ate-snapshots/lab/ax/")
+	if tmpl.GetSnapshotConfig().GetOnCommit() != ateapipb.SnapshotContentScope_SNAPSHOT_CONTENT_SCOPE_DATA {
+		t.Fatal("expected DATA snapshots")
+	}
+	if tmpl.GetSnapshotConfig().GetStorageLocation() != "gs://ate-snapshots/lab/ax/" {
+		t.Fatal("snapshot location was not preserved")
+	}
+	probe := tmpl.GetContainers()[0].GetWakeupProbe().GetHttpGet()
+	if probe.GetPath() != "/readyz" || probe.GetPort() != 80 {
+		t.Fatal("expected an HTTP wakeup probe on /readyz:80")
+	}
+}
