#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
repo_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd) || exit 1
if test -f "$repo_root/.local/launcher.json"; then
  exec "$repo_root/bin/lab" --root "$repo_root" exec bash "$repo_root/scripts/entrypoint.sh" "$@"
fi
exec bash "$repo_root/scripts/entrypoint.sh" "$@"
