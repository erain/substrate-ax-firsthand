# Local-only teaching configuration: Redis is ephemeral; no public ingress.
apiVersion: v1
kind: Namespace
metadata:
  name: firsthand-ax
  labels:
    firsthand-owner: substrate-ax-tutorial
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ax-server
  namespace: firsthand-ax
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: firsthand-redis
  namespace: firsthand-ax
spec:
  replicas: 1
  selector:
    matchLabels: {app: firsthand-redis}
  template:
    metadata:
      labels: {app: firsthand-redis}
    spec:
      containers:
        - name: redis
          image: @REDIS_IMAGE@
          args: [redis-server, --save, "", --appendonly, "no"]
          readinessProbe:
            tcpSocket: {port: 6379}
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: "1", memory: 512Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: firsthand-redis
  namespace: firsthand-ax
spec:
  selector: {app: firsthand-redis}
  ports: [{port: 6379, targetPort: 6379}]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ax-server
  namespace: firsthand-ax
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: ax-server}
  template:
    metadata:
      labels: {app.kubernetes.io/name: ax-server}
    spec:
      serviceAccountName: ax-server
      containers:
        - name: ax-server
          image: @AX_IMAGE@
          args:
            - --addr=:8080
            - --redis-addr=firsthand-redis.firsthand-ax.svc.cluster.local:6379
            - --substrate-endpoint=api.ate-system.svc.cluster.local:443
            - --substrate-authority=api.ate-system.svc
            - --substrate-token-file=/var/run/secrets/ateapi/token
            - --substrate-ca-file=/run/servicedns-ca/trust-bundle.pem
            - --template=unused-default
            - --template-atespace=firsthand
          env:
            - {name: ATENET_ROUTER_ADDR, value: atenet-router.ate-system.svc.cluster.local:80}
            - {name: AX_SNAPSHOTS_BUCKET, value: "gs://ate-snapshots/firsthand/ax/"}
          ports: [{containerPort: 8080}]
          readinessProbe:
            httpGet: {path: /healthz, port: 8080}
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: "1", memory: 1Gi}
          volumeMounts:
            - {name: ate-token, mountPath: /var/run/secrets/ateapi, readOnly: true}
            - {name: servicedns-ca, mountPath: /run/servicedns-ca, readOnly: true}
      volumes:
        - name: ate-token
          projected:
            sources:
              - serviceAccountToken:
                  audience: api.ate-system.svc
                  expirationSeconds: 7200
                  path: token
        - name: servicedns-ca
          projected:
            sources:
              - clusterTrustBundle:
                  labelSelector:
                    matchLabels: {podcert.ate.dev/canarying: live}
                  signerName: servicedns.podcert.ate.dev/identity
                  path: trust-bundle.pem
---
apiVersion: v1
kind: Service
metadata:
  name: ax-server
  namespace: firsthand-ax
spec:
  selector: {app.kubernetes.io/name: ax-server}
  ports: [{port: 8080, targetPort: 8080}]
